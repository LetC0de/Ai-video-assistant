# ── AI Video Assistant — .env.example ──────────────────────────────────────────
# Copy this file to .env and fill in your actual values.

# ── Speech-to-Text ────────────────────────────────────────────────────────────
WHISPER_MODEL="small"

# ── Sarvam AI (STT API) ──────────────────────────────────────────────────────
SARVAM_API_KEY="sk_your_sarvam_api_key"
SARVAM_STT_MODEL="saras:v2.5"

# ── HuggingFace ───────────────────────────────────────────────────────────────
HF_TOKEN="hf_your_huggingface_token"

# ── YouTube Cookies ───────────────────────────────────────────────────────────
YT_COOKIES_FILE="C:\path\to\cookies.txt"

# ── Qdrant (Vector DB) ────────────────────────────────────────────────────────
QDRANT_API_KEY="your_qdrant_api_key"
QDRANT_URL="https://your-cluster.qdrant.io"

# ── Auth (JWT) ────────────────────────────────────────────────────────────────
SECRET_KEY="your_random_secret_key_here"
ALGORITHM="HS256"
EXP_TIME=500

# ── Database (PostgreSQL / Neon) ──────────────────────────────────────────────
DB_CONNECTION="postgresql://user:password@host/database?sslmode=require"

# ── LLM (Mistral — used for embeddings only) ──────────────────────────────────
MISTRAL_API_KEY="your_mistral_api_key"
MISTRAL_MODEL="mistral-small-latest"
MISTRAL_EMBED_MODEL="mistral-embed-2312"
LLM_MODEL="mistral-small-2506"

# ── LLM Chat (OpenRouter — primary LLM provider) ─────────────────────────────
OPENROUTER_API_KEY="sk-or-v1-your_openrouter_key_here"

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS="https://your-frontend.vercel.app"
